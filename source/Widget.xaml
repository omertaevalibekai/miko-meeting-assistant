<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="160" Height="178" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="Мико — маскот" FontFamily="Segoe UI">
 <Grid>
  <Border x:Name="DragZone" Width="120" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,0,0,0" Background="Transparent" ToolTip="Перетащите маскота в удобное место"><ContentControl x:Name="RobotHost" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  <Button x:Name="MenuButton" Content="⋯" Width="30" Height="28" Margin="0,37,7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#E7E3FA" Background="#353145" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand" ToolTip="Меню маскота" AutomationProperties.Name="Меню маскота">
   <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#7463D5"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#7463D5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
  </Button>
  <Border x:Name="StateBadge" Background="#292638" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="9,3" Margin="0,0,0,6"><TextBlock x:Name="WidgetStatus" Text="Мико" FontSize="10" Foreground="#D8D2E8"/></Border>
  <Popup x:Name="MenuPopup" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"><ContentControl x:Name="BubbleHost"/></Popup>
 </Grid>
</Window>
