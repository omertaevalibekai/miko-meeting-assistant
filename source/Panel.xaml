<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="430" Height="585" FontFamily="Segoe UI" FontSize="13" Foreground="#242532">
 <UserControl.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#E9E6F4"/><Setter Property="Foreground" Value="#454059"/><Setter Property="Padding" Value="12,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#7463D5"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEDAE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,9"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="T" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="T" Property="Background" Value="#E5DFF4"/><Setter Property="Foreground" Value="#5B499D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#797384"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/></Style>
 </UserControl.Resources>
 <Border x:Name="Bubble" Background="#F4F4FA" BorderBrush="#D8D2E4" BorderThickness="1" CornerRadius="18" Padding="20,18" Margin="2">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="CloseBubble" Content="×" DockPanel.Dock="Right" Background="Transparent" Padding="7,0" FontSize="22" HorizontalAlignment="Right" ToolTip="Close menu"/><StackPanel><TextBlock x:Name="PetName" Text="Miko" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="A little company for every meeting" Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel></DockPanel>
   <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#AC454B" FontSize="12" Margin="0,9,0,0"/>
   <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,16,0,0">
    <TabItem Header="Record"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0">
     <TextBlock Text="Meeting title" Margin="0,0,0,7"/><TextBox x:Name="MeetingTitle" Text="New meeting" MaxLength="180"/>
     <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Padding="10,13" Background="White" CornerRadius="8" Margin="0,0,5,0"><RadioButton x:Name="RoomMode" GroupName="Mode" Content="In person" IsChecked="True"/></Border><Border Grid.Column="1" Padding="10,13" Background="White" CornerRadius="8" Margin="5,0,0,0"><RadioButton x:Name="OnlineMode" GroupName="Mode" Content="Online call"/></Border></Grid>
     <TextBlock x:Name="ModeHint" Text="Microphone only. Recordings are saved on your computer." Style="{StaticResource Hint}" Margin="1,9,1,13"/>
     <Border Background="#EAE6F5" CornerRadius="10" Padding="14,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Microphone" FontSize="11" Foreground="#797384"/><ProgressBar x:Name="MicMeter" Height="4" Maximum="1" BorderThickness="0" Foreground="#67B5A5" Background="#D7D1E4" Margin="0,9,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Call audio" FontSize="11" Foreground="#797384"/><ProgressBar x:Name="OutputMeter" Height="4" Maximum="1" BorderThickness="0" Foreground="#8D7FC3" Background="#D7D1E4" Margin="0,9,0,0"/></StackPanel></Grid></Border>
     <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="26" HorizontalAlignment="Center" Margin="0,18,0,14"/>
     <Button x:Name="RecordButton" Content="●  Start recording" Background="#7463D5" Foreground="White" Padding="15,13" FontSize="14"/>
     <Button x:Name="CancelProcessing" Content="Cancel processing" Visibility="Collapsed" Margin="0,8,0,0"/>
     <TextBlock Text="After your meeting: audio, a transcript and a short summary. Let everyone know you are recording." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Notes"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="NoteHint" Text="Capture a thought here. Notes you write while recording are attached to that meeting." Style="{StaticResource Hint}" Margin="0,0,0,12"/><TextBox x:Name="Notes" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="NoteSaved" Grid.Row="2" Text="Saved automatically" Style="{StaticResource Hint}" Margin="0,10,0,0"/></Grid></TabItem>
    <TabItem Header="Meetings"><Grid Margin="0,15,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ComboBox x:Name="History" DisplayMemberPath="Caption" MaxDropDownHeight="220"/>
     <TextBlock x:Name="SelectedInfo" Grid.Row="1" Text="Your saved meetings will appear here." Style="{StaticResource Hint}" Margin="0,8,0,9"/>
     <ComboBox x:Name="DocumentKind" Grid.Row="2" Margin="0,0,0,9"><ComboBoxItem Content="Summary" Tag="summary.md"/><ComboBoxItem Content="Transcript with timestamps" Tag="transcript.srt"/><ComboBoxItem Content="Full transcript" Tag="transcript.txt"/><ComboBoxItem Content="Meeting notes" Tag="notes.txt"/></ComboBox>
     <TextBox x:Name="DocumentView" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
     <StackPanel Grid.Row="4" Margin="0,9,0,0"><TextBlock x:Name="PlaybackTime" Text="" Style="{StaticResource Hint}" Margin="0,0,0,5"/><UniformGrid Columns="3"><Button x:Name="PlayAudio" Content="▶ Listen" Margin="0,0,5,0" Padding="5,9"/><Button x:Name="CopyText" Content="Copy" Margin="0,0,5,0" Padding="5,9"/><Button x:Name="Retry" Content="Retry" Padding="5,9"/></UniformGrid></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Appearance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0"><TextBlock Text="Five personalities. Pick your companion." Style="{StaticResource Hint}" Margin="0,0,0,10"/><StackPanel x:Name="MascotChoices"/></StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <StackPanel Grid.Row="3" Margin="0,15,0,0">
    <Border x:Name="ExitConfirm" Background="#EEE3E6" Padding="10" CornerRadius="8" Visibility="Collapsed" Margin="0,0,0,9"><StackPanel><TextBlock Text="Quit Miko? Your current recording will be saved. You can process it again later." TextWrapping="Wrap" FontSize="12"/><UniformGrid Columns="2" Margin="0,8,0,0"><Button x:Name="ConfirmExit" Content="Save and quit" FontSize="11" Margin="0,0,5,0"/><Button x:Name="DismissExit" Content="Stay" FontSize="11"/></UniformGrid></StackPanel></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SettingsButton" Content="⚙  Settings" Background="Transparent" Padding="0,5" HorizontalAlignment="Left"/><Button x:Name="ExitButton" Grid.Column="1" Content="Quit Miko" Background="Transparent" Padding="0,5" HorizontalAlignment="Right" FontSize="12"/></Grid>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>
